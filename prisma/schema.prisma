generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  cpf               String             @unique
  email             String
  password          String
  refresh_token     RefreshToken?
  password_token    PasswordToken?
  show_ad           ShowAd?
  pushTokens        PushToken[]
  userNotifications UserNotification[]  // ← nova relação
  email_change      EmailChange?

  // Anulável de propósito: quem já existia antes desta coluna não tem data de
  // cadastro conhecida, e preencher com o instante da migration falsearia toda
  // estatística de "usuários novos".
  createdAt         DateTime?          @default(now())

  @@index([createdAt])
  @@map("users")
}

model Emails {
  id            String @id @default(uuid())
  censoredEmail String
  email         String

  @@map("emails")
}

model RefreshToken {
  id        String @id @default(uuid())
  expiresIn Int
  user      User   @relation(fields: [userId], references: [id])
  userId    String @unique

  @@map("refresh_token")
}

// Troca de e-mail da conta do app pendente de confirmação por código (enviado
// ao novo e-mail). Uma pendência por usuário; expira e é consumida na confirmação.
model EmailChange {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  newEmail   String
  codcliente String? // contrato (codcliente) alvo da troca na Predialnet
  code       String
  expiresIn  DateTime
  createdAt  DateTime @default(now())

  @@map("email_changes")
}

model PasswordToken {
  id        String   @id @default(uuid())
  expiresIn DateTime
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique

  @@map("password_token")
}

model ShowAd {
  id        String   @id @default(uuid())
  expiresIn DateTime
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  show      Boolean  @default(true)

  @@map("show_ad")
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("push_tokens")
}

model Notification {
  id                 String             @id @default(uuid())
  title              String
  body               String?
  data               Json?
  status             String             @default("pending")
  tokens             Int                @default(0)
  receipts           Json?              
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  userNotifications  UserNotification[] 

  @@index([createdAt])
  @@map("notifications")
}

model UserMetadata {
  userId      String   @id
  hasOpenBill Boolean  @default(false)
  address     String?
  updatedAt   DateTime @updatedAt

  @@map("user_metadata")
}

model UserNotification {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId String
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@map("user_notifications")
  @@index([userId])
  @@index([notificationId])
}

// ─── Chamados de suporte (tickets / kanban) ─────────────────────────────────

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO
  RESOLVIDO
  FECHADO
}

enum TicketPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model Ticket {
  id          String         @id @default(uuid())
  number      Int            @unique @default(autoincrement()) // nº do chamado (sequencial)
  subject     String
  description String         @db.Text
  status      TicketStatus   @default(ABERTO)
  priority    TicketPriority @default(MEDIA)
  category    String?
  position    Int            @default(0) // ordenação dentro da coluna (kanban)

  // Quem abriu (operador) e cliente relacionado (dados vêm da API via CPF)
  requesterName String?
  cpf           String?
  codcliente    String?

  // Atendimento
  assignee   String?
  closedAt   DateTime?
  deleted_at DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  comments    TicketComment[]
  attachments TicketAttachment[]

  @@index([status])
  @@index([cpf])
  @@index([createdAt])
  @@map("tickets")
}

model TicketAttachment {
  id         String   @id @default(uuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  ticketId   String
  filename   String
  mimeType   String?
  size       Int?
  storageKey String // chave do objeto no bucket
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketComment {
  id        String   @id @default(uuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String
  author    String? // operador ou "sistema"
  body      String   @db.Text
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

// ─── App Messages ────────────────────────────────────────────────────────────

enum TargetingType {
  GLOBAL
  CLIENTE
  CIDADE
  BAIRRO_CIDADE
  RUA
  CEP
  CEP_NUMERO
}

model AppMessage {
  id          String             @id @default(uuid())
  title       String
  msg_cliente String             @db.Text
  timeout_sec Int                @default(10)
  active      Boolean            @default(true)
  deleted_at  DateTime?
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt
  targets     AppMessageTarget[]

  @@index([active, deleted_at])
  @@map("app_messages")
}

model AppMessageTarget {
  id              String        @id @default(uuid())
  message         AppMessage    @relation(fields: [messageId], references: [id])
  messageId       String
  targeting_type  TargetingType
  targeting_value String        @default("*")

  @@index([targeting_type, targeting_value])
  @@map("app_message_targets")
}

model ClientAddress {
  id         String   @id @default(uuid())
  cpf        String   @unique
  cidade     String?
  bairro     String?
  cep        String?
  numero     String?
  updated_at DateTime @updatedAt

  @@index([cep])
  @@map("client_addresses")
}

// ─── Speedtest nativo ────────────────────────────────────────────────────────
// Um registro por teste concluído/abortado no app. O app mede no cliente
// (src/speedtest/engine.ts) e envia o resultado detalhado para POST /speedtest/result.

model SpeedTest {
  id     String  @id @default(uuid())

  // Identificação do cliente (do JWT, quando autenticado)
  userId String?
  cpf    String?

  // Resultados principais
  downloadMbps Float? // vazão de download (Mbit/s)
  uploadMbps   Float? // vazão de upload (Mbit/s)
  pingMs       Float? // latência média (ms)
  jitterMs     Float? // variação da latência (ms)
  packetLoss   Float? // perda de pacotes (0-100 %), se medida

  // Fase de download
  downloadBytes       Float? // bytes transferidos na janela de medição
  downloadDurationMs  Int?   // duração efetiva da medição de download
  downloadConnections Int?   // conexões paralelas usadas

  // Fase de upload
  uploadBytes       Float?
  uploadDurationMs  Int?
  uploadConnections Int?

  // Ping
  pingSamplesCount Int?
  pingSamples      Json? // array bruto de amostras (ms)

  // Contexto do cliente / dispositivo
  appVersion     String?
  platform       String? // ios | android | web
  osVersion      String?
  deviceModel    String?
  connectionType String? // wifi | cellular | ethernet | unknown
  carrier        String? // operadora móvel, quando aplicável

  // Contexto capturado no servidor
  clientIp   String?
  userAgent  String? @db.Text
  serverHost String? // base URL do speedtest usada pelo app

  // Metadados de execução
  status       String    @default("completed") // completed | aborted | error
  errorMessage String?   @db.Text
  config       Json?     // DEFAULT_CONFIG efetivo usado no teste
  raw          Json?     // payload extra do engine, para não perder nada
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([cpf])
  @@index([userId])
  @@index([createdAt])
  @@index([cpf, createdAt])
  @@map("speed_tests")
}

// ─── Blog ────────────────────────────────────────────────────────────────────
// Backend do blog. O front fica em blog.predialnet.com.br (Next.js, projeto
// separado): lê os endpoints públicos e escreve pelos /blog/admin/*.
// Contrato completo em blog-api.md.
//
// Ids inteiros (e não uuid como no resto do schema) porque o front já está
// escrito contra `"id": 12`.

enum BlogStatus {
  rascunho
  publicado
  arquivado
}

enum BlogPapel {
  admin
  editor
}

model BlogCategoria {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  nome      String
  descricao String?      @db.Text
  ordem     Int          @default(0)
  criado_em DateTime     @default(now())
  artigos   BlogArtigo[]

  @@map("blog_categorias")
}

model BlogArtigo {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  titulo      String
  resumo      String        @db.Text
  categoria   BlogCategoria @relation(fields: [categoriaId], references: [id])
  categoriaId Int
  autor       String        @default("Predialnet")
  corpo       String        @db.LongText // HTML já sanitizado na escrita

  // Duas imagens independentes, achatadas no banco e aninhadas na resposta.
  // capa: card da listagem, páginas de categoria e Open Graph (16:9).
  // capa_interna: topo da página do post, no tamanho original.
  capa_url     String? @db.Text
  capa_alt     String?
  capa_largura Int?
  capa_altura  Int?

  capa_interna_url     String? @db.Text
  capa_interna_alt     String?
  capa_interna_largura Int?
  capa_interna_altura  Int?

  destaque      Boolean    @default(false) // só um artigo por vez
  status        BlogStatus @default(rascunho)
  publicado_em  DateTime?
  criado_em     DateTime   @default(now())
  atualizado_em DateTime   @updatedAt
  tempo_leitura Int        @default(1)
  visualizacoes Int        @default(0)

  // Última vez que o blog (Next) foi avisado sobre este artigo. O job de
  // agendados usa isto para saber quem já entrou no ar e quem falta avisar.
  revalidado_em DateTime?

  // SEO (achatado no banco, aninhado na resposta da API)
  seo_titulo    String?
  seo_descricao String? @db.Text
  seo_noindex   Boolean @default(false)

  @@index([status, publicado_em])
  @@index([status, publicado_em, revalidado_em])
  @@index([categoriaId])
  @@index([destaque])
  @@map("blog_artigos")
}

model BlogUsuario {
  id         Int       @id @default(autoincrement())
  nome       String
  email      String    @unique
  senha_hash String // bcrypt
  papel      BlogPapel @default(editor)
  ativo      Boolean   @default(true)
  ultimo_login DateTime?
  criado_em  DateTime  @default(now())

  refresh_tokens BlogRefreshToken[]

  @@map("blog_usuarios")
}

// Refresh token opaco: o banco guarda só o sha256, nunca o valor emitido.
model BlogRefreshToken {
  id         String      @id @default(uuid())
  usuario    BlogUsuario @relation(fields: [usuarioId], references: [id])
  usuarioId  Int
  token_hash String      @unique
  expira_em  DateTime
  revogado_em DateTime?
  criado_em  DateTime    @default(now())

  @@index([usuarioId])
  @@map("blog_refresh_tokens")
}

model BlogNewsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  origem    String?
  ativo     Boolean  @default(true)
  criado_em DateTime @default(now())

  @@map("blog_newsletter")
}

// Slug antigo → slug novo, para o site emitir 301 e não perder ranking.
model BlogRedirecionamento {
  id        Int      @id @default(autoincrement())
  de        String   @unique
  para      String
  criado_em DateTime @default(now())

  @@map("blog_redirecionamentos")
}

model BlogAuditoria {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?
  usuarioNome String?
  acao        String // login | criar | editar | publicar | excluir | upload
  entidade    String // artigo | usuario | midia
  entidadeId  String?
  detalhes    String?  @db.Text
  ip          String?
  criado_em   DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([criado_em])
  @@map("blog_auditoria")
}
