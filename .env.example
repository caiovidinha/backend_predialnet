CLIENT_ID=
CLIENT_SECRET=
URL=http://localhost:3333
PORT=3333
NODE_ENV="development"
DATABASE_URL=""

PUSH_AUTH_TOKEN=token
SWAGGER_TOKEN=meu_token_seguro

ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

API_LOGIN=""
API_PASS=""

APISAPO_TOKEN=
APISAPO_URL=https://apisapo.intranet.com.br/v1
APISAPO_TIMEOUT_MS=30000
# Origens permitidas no CORS do endpoint /eh-cliente (separar por vírgula para múltiplas)
ACTIVATION_SITE_ORIGIN=https://www.predialnet.com.br

MIN_APP_VERSION=2.0.9
LATEST_APP_VERSION=2.0.9

# Feature flag: habilita autenticação JWT nos endpoints protegidos
# false = comportamento legado (sem JWT), true = JWT obrigatório
ENABLE_JWT=false

# Chamados de suporte
# Destino da notificação de novo chamado (padrão: caiomdavidinha@gmail.com)
SUPPORT_NOTIFY_EMAIL=
# Limite por anexo em MB (padrão 25)
TICKET_MAX_UPLOAD_MB=25

# Object storage (anexos) — S3-compatível (Cloudflare R2 / Backblaze B2 / AWS S3 / MinIO)
# Ex.: Cloudflare R2 → S3_REGION=auto e S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
# Validade (segundos) da URL de download assinada (padrão 300)
S3_URL_TTL_SEC=300
# ─── Blog ────────────────────────────────────────────────────────────────────
# Segredo do access token do painel (JWT). Separado do ACCESS_TOKEN_SECRET do
# app de propósito: vazar um não derruba o outro. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BLOG_ACCESS_TOKEN_SECRET=
# Tempo de vida do access token, em segundos (padrão 900 = 15 min)
BLOG_ACCESS_TTL_SEC=900
# Validade do refresh token, em dias (padrão 30)
BLOG_REFRESH_TTL_DIAS=30

# Origens liberadas no CORS do blog (separar por vírgula). NUNCA use "*" aqui:
# as rotas /blog/admin/* trafegam credenciais.
# Vazio = usa o padrão do código (blog. + www. + raiz predialnet.com.br).
# Em NODE_ENV=development o localhost:3000 (next dev) entra automaticamente.
# Só afeta chamada de navegador: o que o Next busca no servidor não passa por CORS.
BLOG_CORS_ORIGINS=https://blog.predialnet.com.br,https://www.predialnet.com.br

# Base pública usada para montar a URL das imagens (/blog/midia/<arquivo>)
BLOG_PUBLIC_BASE_URL=https://appgw.predialnet.com.br
# Onde as imagens são gravadas (padrão: <raiz do projeto>/uploads/blog)
BLOG_MEDIA_DIR=
# Limite por imagem, em MB (padrão 8)
BLOG_UPLOAD_MAX_MB=8
# Largura máxima da imagem processada (só tem efeito com o sharp instalado)
BLOG_IMAGE_MAX_WIDTH=1600

# Revalidação do cache do blog (Next.js). Ao publicar, editar artigo publicado
# ou arquivar, a API faz POST aqui com { "slug": "..." } e o header
# X-Revalidate-Secret. Vazio = o blog revalida sozinho a cada 5 min.
BLOG_REVALIDATE_URL=https://blog.predialnet.com.br/api/revalidate
# Precisa ser IGUAL ao REVALIDATE_SECRET configurado no blog (Vercel).
# Gere com: openssl rand -hex 32
BLOG_REVALIDATE_SECRET=
# Timeout da chamada (ms). Curto porque o editor espera a resposta do publicar.
BLOG_REVALIDATE_TIMEOUT_MS=5000

# Job que avisa o blog quando um artigo agendado chega a hora.
# Desligue com BLOG_SCHEDULER_ATIVO=false (ex.: se o PM2 rodar em cluster e
# você preferir um processo único cuidando disso).
BLOG_SCHEDULER_ATIVO=true
BLOG_SCHEDULER_INTERVALO_MS=60000
